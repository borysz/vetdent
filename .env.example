# Másold le ezt a fájlt `.env.local` néven, és töltsd ki az értékeket.
# A `.env.local` soha nem kerül a Gitbe.

# Az alkalmazás nyilvános címe (fejlesztés közben a helyi gép).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (2. fázistól) ---------------------------------------------
# A Supabase-projekt beállításai között találhatók (API-kulcsok oldal).
# A projekt címe, pl. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Nyilvános kulcs („publishable”, régebbi nevén „anon”) – a böngészőbe is kikerül.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Titkos kulcs („secret”, régebbi nevén „service_role”) – CSAK a szerveren
# használható, soha ne oszd meg és ne másold máshová.
SUPABASE_SECRET_KEY=

# A Stripe- és Számlázz.hu-beállítások a 4. fázisban kerülnek ide.
